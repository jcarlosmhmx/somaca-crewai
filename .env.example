# Copia este archivo como .env y llena tu llave.
# (.env está en .gitignore: nunca subas tus llaves al repositorio.)
# Ojo: la suscripción de Claude Pro NO incluye API; la llave sale de
# console.anthropic.com (se carga saldo aparte, se cobra por uso).

# Desarrollo/depuración: haiku (barato). Corrida final de la demo: sonnet.
MODEL=anthropic/claude-haiku-5-5
# MODEL=anthropic/claude-sonnet-5-5
# Respaldo gratis (local): MODEL=ollama/llama3.1 y OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0.2

ANTHROPIC_API_KEY=

# Semilla del simulador de Meta Ads (reproducibilidad de la demo)
SIM_SEED=42
