# Copia este archivo como .env y llena tu llave.
# (.env está en .gitignore: nunca subas tus llaves al repositorio.)
# La suscripción de ChatGPT/Claude NO incluye API: la llave sale de la consola del proveedor.

# ---------------- LLM (elige UNO) ----------------
# OpenAI (recomendado para la demo final)
MODEL=openai/gpt-5.4-mini
OPENAI_API_KEY=

# Anthropic (modelo de la corrida grabada de la Fase 3)
# MODEL=anthropic/claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Local y gratis con Ollama (más lento; útil si no hay internet)
# MODEL=ollama/llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Solo para modelos que la aceptan (Ollama, GPT-4.x). GPT-5.x y Claude 5.x la rechazan.
# TEMPERATURE=0.2

# ---------------- Simulador y datos ----------------
# Semilla del simulador de Meta Ads (reproducibilidad de la demo)
SIM_SEED=13
# Base de datos SQLite de corridas, eventos y decisiones
SOMACA_DB=data/somaca.db

# ---------------- GUI ----------------
# URL de la API que usa Streamlit
SOMACA_API=http://localhost:8000
# Velocidad del modo respaldo (1 = tiempo de la grabación, ~1 min)
REPLAY_VELOCIDAD=1.0
